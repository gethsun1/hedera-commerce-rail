# Optional public WalletConnect project ID (browser-visible; a Scaffold HBAR
# default is used when unset). These RPC overrides are also public settings.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Server-side Testnet Reference Application configuration. Private credentials are used
# only by the audit route after a wallet-confirmed escrow transaction.
# Keep credentials here without a NEXT_PUBLIC_ prefix. Do not copy them into
# client-side environment variables.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HCS_TOPIC_ID=
MIRROR_NODE_BASE_URL=

# Optional Mirror Node endpoint overrides used by the account lookup route.
HEDERA_MIRROR_TESTNET_URL=
HEDERA_MIRROR_MAINNET_URL=
