# Hedera account and signing configuration for Hardhat tools and the server-side SDK.
# local targets a separately running Hedera Local Node SDK service; it needs no account credentials.
HEDERA_NETWORK=testnet
# Set these to a dedicated Hedera account and its private key for testnet/mainnet.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Optional JSON-RPC override for the Hardhat EVM fork provider.
HEDERA_RPC_URL=

# Optional Mirror Node endpoint override. Default URL follows HEDERA_NETWORK.
# Must be an HTTPS origin; never pass a request-controlled URL into the server-side client.
MIRROR_NODE_BASE_URL=

# Optional HCS audit stream. Provision once with `npm run hcs:topic:create -w @sh/hardhat`.
# Public topic IDs have form shard.realm.number; never place credentials in topic messages.
HCS_TOPIC_ID=
# Optional: public key controlling submissions to a private topic. Leave blank for a public topic.
# The configured HEDERA_PRIVATE_KEY must correspond to this submit key when publishing.
HCS_TOPIC_SUBMIT_KEY=
# Mainnet writes are disabled unless explicitly opted in.
HCS_ALLOW_MAINNET=false

# Only for the legacy M4.1 Testnet refund diagnostic; leave blank otherwise.
M41_TOKEN_ID=
M41_PAYEE_ADDRESS=
