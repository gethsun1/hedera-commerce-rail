# Hedera account and signing configuration for Hardhat tools and the server-side SDK.
# local targets a separately running Hedera Local Node SDK service; it needs no account credentials.
HEDERA_NETWORK=testnet
# Set these to a dedicated Hedera account and its private key for testnet/mainnet.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Optional JSON-RPC override for the Hardhat EVM fork provider.
HEDERA_RPC_URL=
