{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/browser"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client.ts", "src/index.ts", "src/internal/hcs/**", "src/internal/hedera/**", "src/internal/mirror-node/**"]
}
