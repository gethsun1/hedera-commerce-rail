# Hedera SDK network and signer configuration. A live network requires explicit credentials.
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_RPC_URL=
HCS_TOPIC_ID=
HCS_TOPIC_SUBMIT_KEY=
