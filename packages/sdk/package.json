{
  "name": "@hedera-commerce/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/sdk/src/index.js",
  "types": "dist/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "require": "./dist/sdk/src/index.js",
      "default": "./dist/sdk/src/index.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint --config ../hardhat/eslint.config.mjs src test",
    "test": "TS_NODE_TRANSPILE_ONLY=true mocha --require ts-node/register \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.80.0",
    "ethers": "^6.14.0"
  },
  "devDependencies": {
    "@types/mocha": "~10.0.10",
    "mocha": "^10.0.0",
    "typescript": "^5.8.2",
    "ts-node": "~10.9.1",
    "@types/node": "^18.19.0"
  }
}
